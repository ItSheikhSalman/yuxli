<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= brand.name %> · Sign in</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/icon-32.png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <link rel="stylesheet" href="/dashboard.css" />
  </head>
  <body class="gateway-page">
    <main class="gateway-shell">
      <section class="gateway-story" aria-label="About <%= brand.name %>">
        <div class="brand-lockup" aria-label="<%= brand.name %>">
          <img src="/brand/mark.svg" alt="" />
          <span><strong><%= brand.name %></strong><small><%= brand.tagline %></small></span>
        </div>

        <div class="gateway-copy">
          <span class="eyebrow">Autonomous System · Enterprise Edition</span>
          <h2>The quiet intelligence behind every chat.</h2>
          <p>Realtime WhatsApp AI engine, automated group moderation, scheduler, and anti-ban shield—hosted for enterprise reliability.</p>

          <div style="display:flex; flex-wrap:wrap; gap:8px; margin-top:24px;">
            <span style="display:inline-flex; align-items:center; gap:6px; padding:4px 10px; border-radius:999px; font-size:11px; font-weight:700; background:rgba(16,185,129,0.15); border:1px solid rgba(16,185,129,0.3); color:#34d399;">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              Anti-Ban Shield v4.2
            </span>
            <span style="display:inline-flex; align-items:center; gap:6px; padding:4px 10px; border-radius:999px; font-size:11px; font-weight:700; background:rgba(99,102,241,0.15); border:1px solid rgba(99,102,241,0.3); color:#818cf8;">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              SaaS Multi-User
            </span>
            <span style="display:inline-flex; align-items:center; gap:6px; padding:4px 10px; border-radius:999px; font-size:11px; font-weight:700; background:rgba(6,182,212,0.15); border:1px solid rgba(6,182,212,0.3); color:#22d3ee;">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              Zero Cloud Leak
            </span>
          </div>
        </div>

        <div class="gateway-mark" aria-hidden="true">
          <span class="gateway-ring"></span>
          <img src="/brand/mark.svg" alt="" />
        </div>

        <p class="gateway-trust">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline; vertical-align:middle; margin-right:6px;"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          Enterprise workspace · cryptographic isolation
        </p>
      </section>

      <section class="gateway-panel">
        <div class="gateway-panel-inner">
          <form class="card auth-card" id="login-card" action="/login" method="post">
            <button type="button" class="gateway-back-btn" id="login-back-app" hidden>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
              <span>Back to app</span>
            </button>
            <div class="auth-head">
              <span class="eyebrow">Enterprise Sign In</span>
              <h1>Welcome Back</h1>
              <p class="sub">Access your corporate WhatsApp automation command deck.</p>
            </div>

            <label class="field">
              <span>Work Email</span>
              <div class="input-wrap">
                <input
                  type="email"
                  name="email"
                  autocomplete="username"
                  placeholder="alex@company.com (or leave empty for master key)"
                  autofocus
                />
              </div>
            </label>

            <label class="field">
              <span>Account Password</span>
              <div class="input-wrap">
                <input
                  type="password"
                  name="password"
                  autocomplete="current-password"
                  placeholder="Enter your password"
                  required
                />
                <button type="button" class="eye-btn" aria-label="Show password">
                  <svg class="eye-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                  <svg class="eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c6.5 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3.5 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" x2="22" y1="2" y2="22"/></svg>
                </button>
              </div>
            </label>

            <button type="submit" class="btn btn-primary auth-submit">
              Sign In to Command Center
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </button>

            <% if (error) { %>
            <div class="error" role="alert"><%= error %></div>
            <% } %>

            <div class="auth-alt" style="display:flex; justify-content:space-between; align-items:center; margin-top:16px;">
              <a href="/signup" style="color:var(--primary, #6366f1); font-size:13px; font-weight:600; text-decoration:none;">Create Workspace</a>
              <button type="button" class="link-btn" id="forgot-link">Forgot password?</button>
            </div>
          </form>

          <div class="card auth-card" id="reset-card" hidden>
            <button type="button" class="gateway-back-btn" id="reset-back">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
              <span>Back to sign in</span>
            </button>
            <div class="auth-head">
              <span class="eyebrow">Password reset</span>
              <h1>Reset your password</h1>
              <p class="sub">
                Yuxli sends a one-time code to your WhatsApp — the linked account's own chat.
                The code works for 10 minutes.
              </p>
            </div>

            <button type="button" class="btn btn-primary auth-submit" id="reset-send">
              Send code to WhatsApp
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </button>

            <form id="reset-form" hidden>
              <label class="field">
                <span>Reset code</span>
                <input
                  type="text"
                  id="reset-code"
                  inputmode="numeric"
                  autocomplete="one-time-code"
                  maxlength="6"
                  placeholder="6 digits"
                  required
                />
              </label>

              <label class="field">
                <span>New password</span>
                <div class="input-wrap">
                  <input
                    type="password"
                    id="reset-pass"
                    autocomplete="new-password"
                    placeholder="At least <%= minLength %> characters"
                    minlength="<%= minLength %>"
                    required
                  />
                  <button type="button" class="eye-btn" aria-label="Show password">
                    <svg class="eye-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                    <svg class="eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c6.5 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3.5 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" x2="22" y1="2" y2="22"/></svg>
                  </button>
                </div>
              </label>

              <label class="field">
                <span>Repeat password</span>
                <div class="input-wrap">
                  <input
                    type="password"
                    id="reset-confirm"
                    autocomplete="new-password"
                    placeholder="Type it again"
                    minlength="<%= minLength %>"
                    required
                  />
                  <button type="button" class="eye-btn" aria-label="Show password">
                    <svg class="eye-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                    <svg class="eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c6.5 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3.5 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" x2="22" y1="2" y2="22"/></svg>
                  </button>
                </div>
              </label>

              <button type="submit" class="btn btn-primary auth-submit">
                Set new password
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </button>
            </form>

            <div class="error" id="reset-error" role="alert" hidden></div>

          </div>

          <div class="foot"><%= brand.name %> by <%= brand.developer %> · <%= brand.studio %></div>
        </div>
      </section>
    </main>

    <script src="/gateway.js"></script>
    <script>
      (function () {
        // Android app: show back-to-app buttons, localize labels
        var inApp = typeof window.LevixHost !== "undefined" && typeof window.LevixHost.closePanel === "function";
        if (inApp) {
          var isAr = false;
          try { isAr = localStorage.getItem("levix_lang") === "ar"; } catch(e) {}
          var backLabel = isAr ? "العودة للتطبيق" : "Back to app";
          var resetBackLabel = isAr ? "العودة لتسجيل الدخول" : "Back to sign in";
          ["login-back-app"].forEach(function(id) {
            var btn = document.getElementById(id);
            if (btn) {
              btn.hidden = false;
              btn.querySelector("span").textContent = backLabel;
              if (isAr) { btn.dir = "rtl"; btn.style.direction = "rtl"; }
              btn.addEventListener("click", function() { window.LevixHost.closePanel(); });
            }
          });
          var resetBackBtn = document.getElementById("reset-back");
          if (resetBackBtn && isAr) {
            resetBackBtn.querySelector("span").textContent = resetBackLabel;
            resetBackBtn.dir = "rtl";
            resetBackBtn.style.direction = "rtl";
          }
        }

        var loginCard = document.getElementById("login-card");
        var resetCard = document.getElementById("reset-card");
        var sendBtn = document.getElementById("reset-send");
        var form = document.getElementById("reset-form");
        var errorBox = document.getElementById("reset-error");

        function showReset() {
          loginCard.hidden = true;
          resetCard.hidden = false;
        }
        function showLogin() {
          resetCard.hidden = true;
          loginCard.hidden = false;
          document.getElementById("forgot-link").focus();
        }
        function showError(text) {
          errorBox.textContent = text;
          errorBox.hidden = false;
        }
        function hideError() {
          errorBox.hidden = true;
        }
        async function postJson(url, body) {
          const response = await fetch(url, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(body || {}),
          });
          let data = {};
          try {
            data = await response.json();
          } catch {}
          return data;
        }

        document.getElementById("forgot-link").addEventListener("click", showReset);
        document.getElementById("reset-back").addEventListener("click", showLogin);

        document.addEventListener("keydown", function(e) {
          if (e.key === "Escape" && !resetCard.hidden) {
            showLogin();
          }
        });

        sendBtn.addEventListener("click", async function () {
          sendBtn.disabled = true;
          hideError();
          try {
            const result = await postJson("/reset/request");
            if (result.ok) {
              sendBtn.hidden = true;
              form.hidden = false;
              document.getElementById("reset-code").focus();
            } else if (result.reason === "throttled") {
              showError("Too many requests. Try again in " + (result.retryAfter || 60) + " seconds.");
            } else if (result.reason === "no_session") {
              showError(
                "WhatsApp isn't connected, so the code can't be sent. " +
                  "Sign in on the server and run `yuxli reset-password`, or start the WhatsApp session first."
              );
            } else if (result.reason === "send_failed") {
              showError("Couldn't send the WhatsApp message. Try again in a minute.");
            } else {
              showError("Couldn't start the reset. Try again.");
            }
          } catch {
            showError("Couldn't reach the server. Try again.");
          }
          sendBtn.disabled = false;
        });

        form.addEventListener("submit", async function (event) {
          event.preventDefault();
          hideError();
          try {
            const result = await postJson("/reset/confirm", {
              code: document.getElementById("reset-code").value,
              password: document.getElementById("reset-pass").value,
              confirm: document.getElementById("reset-confirm").value,
            });
            if (result.ok) {
              form.hidden = true;
              sendBtn.hidden = true;
              showError("Password updated. Taking you to sign in…");
              setTimeout(function () {
                window.location.href = "/";
              }, 900);
              return;
            }
            if (result.reason === "wrong_code") {
              showError(
                "Wrong code." +
                  (result.attemptsLeft ? " " + result.attemptsLeft + " attempts left." : "")
              );
            } else if (
              result.reason === "expired" ||
              result.reason === "no_pending" ||
              result.reason === "too_many_attempts"
            ) {
              showError("That code is no longer valid. Send a new one.");
              form.hidden = true;
              sendBtn.hidden = false;
            } else if (result.reason === "mismatch") {
              showError("The two passwords don't match.");
            } else if (result.reason === "invalid_password") {
              showError(result.message || "That password isn't allowed.");
            } else {
              showError("Couldn't reset the password. Try again.");
            }
          } catch {
            showError("Couldn't reach the server. Try again.");
          }
        });
      })();
    </script>
  </body>
</html>
